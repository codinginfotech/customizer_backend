# ============================================================================
# Makely API — environment
# Local development values. On the deploy platform, paste this file into the
# service's variables and change the lines marked "PROD:".
# ============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
# PROD: most platforms inject PORT themselves; keep 4000 if yours doesn't.
PORT=4000
# PROD: only needed when the browser calls the API cross-origin (no nginx proxy).
CLIENT_URL=http://localhost:5173
# Proxy hops in front of the API, so rate limits see the real client IP:
#   1 = just the frontend nginx (docker compose)
#   2 = hosting edge -> frontend nginx -> API over the private network
#   3 = hosting edge -> frontend nginx -> hosting edge -> API (public API_UPSTREAM)
TRUST_PROXY=1

# --- Database (MySQL) -------------------------------------------------------
# Any MySQL 8 instance. Local Docker (npm run db:up) maps port 3308 to the
# container's 3306. Percent-encode special characters in the password (@ = %40).
DATABASE_URL="mysql://customizer:customizer@localhost:3308/customizer"

# --- Auth -------------------------------------------------------------------
# Random 64-byte secrets. PROD: generate fresh ones, never reuse dev values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Google sign-in — Firebase project whose ID tokens the API accepts.
# Must match VITE_FIREBASE_PROJECT_ID on the frontend. Leave blank to disable.
FIREBASE_PROJECT_ID=customizer-makely

# Seeded admin account. Required in production (no admin is created without
# them); the README dev logins are only used against a local database.
# The password is re-applied on every start — rotate it here and redeploy.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Storage ----------------------------------------------------------------
# "local" writes to UPLOAD_DIR on disk; "s3" uses any S3-compatible bucket.
# PROD: container disks are ephemeral — use "s3" (or a persistent volume).
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# --- Commerce ---------------------------------------------------------------
TAX_RATE=0.08
FLAT_SHIPPING=5.99
FREE_SHIPPING_THRESHOLD=75

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=15

# --- Shopify app (optional) -------------------------------------------------
# Leave blank to disable /api/shopify entirely. Values come from the app you
# create in the Shopify Partner dashboard (or `shopify app config link`).
# See docs/SHOPIFY.md for the full setup.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public URL of the app = this deployment's FRONTEND origin (/api is proxied).
# Must match application_url in shopify-app/shopify.app.toml.
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_products,read_orders
SHOPIFY_API_VERSION=2026-04
# Optional 32+ char key for encrypting store access tokens at rest.
# Defaults to a key derived from SHOPIFY_API_SECRET.
SHOPIFY_TOKEN_ENCRYPTION_KEY=
