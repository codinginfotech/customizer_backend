# ============================================================================
# Makely API — environment
# Local development values. On the deploy platform, paste this file into the
# service's variables and change the lines marked "PROD:".
# ============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
# PROD: most platforms inject PORT themselves; keep 4000 if yours doesn't.
PORT=4000
# PROD: only needed when the browser calls the API cross-origin (no nginx proxy).
CLIENT_URL=http://localhost:5173

# --- Database (MySQL) -------------------------------------------------------
# Port 3308 matches docker-compose (mapped from the container's 3306).
# PROD: use the platform's MySQL connection string.
DATABASE_URL="mysql://customizer:customizer@localhost:3308/customizer"

# --- Auth -------------------------------------------------------------------
# Random 64-byte secrets. PROD: generate fresh ones, never reuse dev values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Google sign-in — Firebase project whose ID tokens the API accepts.
# Must match VITE_FIREBASE_PROJECT_ID on the frontend. Leave blank to disable.
FIREBASE_PROJECT_ID=customizer-makely

# --- Storage ----------------------------------------------------------------
# "local" writes to UPLOAD_DIR on disk; "s3" uses any S3-compatible bucket.
# PROD: container disks are ephemeral — use "s3" (or a persistent volume).
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# --- Commerce ---------------------------------------------------------------
TAX_RATE=0.08
FLAT_SHIPPING=5.99
FREE_SHIPPING_THRESHOLD=75

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=15
