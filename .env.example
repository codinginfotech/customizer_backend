# Database (MySQL)
# Port 3308 matches docker-compose (mapped from the container's 3306)
DATABASE_URL="mysql://customizer:customizer@localhost:3308/customizer"

# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Auth — generate long random strings for production
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Google sign-in — Firebase project whose ID tokens the API accepts.
# Must match VITE_FIREBASE_PROJECT_ID on the frontend. Leave blank to disable.
FIREBASE_PROJECT_ID=customizer-makely

# Storage: "local" (development) or "s3" (production, S3-compatible)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
# S3-compatible storage (used when STORAGE_PROVIDER=s3)
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# Commerce
TAX_RATE=0.08
FLAT_SHIPPING=5.99
FREE_SHIPPING_THRESHOLD=75

# Uploads
MAX_UPLOAD_MB=15
