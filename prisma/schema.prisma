generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the musl/OpenSSL 3 target is what the
  // node:22-alpine Docker image needs (Alpine no longer ships OpenSSL 1.1).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum ModelType {
  GLTF
  PRIMITIVE
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model User {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(120)
  email         String       @unique @db.VarChar(190)
  passwordHash  String       @db.VarChar(255)
  role          Role         @default(USER)
  status        EntityStatus @default(ACTIVE)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  refreshTokens  RefreshToken[]
  actionTokens   ActionToken[]
  designs        Design[]
  uploadedAssets UploadedAsset[]
  cart           Cart?
  orders         Order[]

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ActionToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      TokenType
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("action_tokens")
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(120)
  slug        String       @unique @db.VarChar(140)
  description String?      @db.Text
  sortOrder   Int          @default(0)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id              Int          @id @default(autoincrement())
  categoryId      Int
  name            String       @db.VarChar(160)
  slug            String       @unique @db.VarChar(180)
  description     String?      @db.Text
  basePrice       Decimal      @db.Decimal(10, 2)
  /// JSON pricing rules consumed by the pricing engine (PricingRules schema)
  pricingRules    Json?
  /// JSON array of ProductTag merchandising labels
  tags            Json?
  /// JSON ProductMetadata (material, care, weight, dimensions, shipping class)
  metadata        Json?
  /// JSON array of supported PrintMethod values
  printMethods    Json?
  /// JSON ProductionRules consumed by the design validator
  productionRules Json?
  /// Incremented on every admin edit; orders reference the version they bought
  version         Int          @default(1)
  featured        Boolean      @default(false)
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category              Category                @relation(fields: [categoryId], references: [id])
  variants              ProductVariant[]
  printAreas            ProductPrintArea[]
  images                ProductImage[]
  model                 ProductModel?
  designs               Design[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  shopifyMappings       ShopifyProductMapping[]
  shopifyCustomizations ShopifyCustomization[]
  shopifyOrderItems     ShopifyOrderItem[]

  @@index([categoryId])
  @@index([status, featured])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String  @db.VarChar(500)
  alt       String? @db.VarChar(200)
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        Int          @id @default(autoincrement())
  productId Int
  name      String       @db.VarChar(160)
  color     String?      @db.VarChar(30)
  colorName String?      @db.VarChar(60)
  size      String?      @db.VarChar(40)
  material  String?      @db.VarChar(80)
  sku       String       @unique @db.VarChar(80)
  /// Optional price override; falls back to product basePrice
  price     Decimal?     @db.Decimal(10, 2)
  stock     Int          @default(0)
  status    EntityStatus @default(ACTIVE)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductPrintArea {
  id               Int      @id @default(autoincrement())
  productId        Int
  /// Stable key referenced by design JSON, e.g. "front"
  key              String   @db.VarChar(64)
  name             String   @db.VarChar(100)
  width            Int
  height           Int
  maxDesignWidth   Int?
  maxDesignHeight  Int?
  bleed            Int      @default(0)
  /// JSON: { x, y, width, height } in canvas px
  safeArea         Json
  physicalWidthIn  Decimal? @db.Decimal(6, 2)
  physicalHeightIn Decimal? @db.Decimal(6, 2)
  /// JSON mockup placement (percentages over the base image)
  mockup           Json?
  templateImage    String?  @db.VarChar(500)
  modelMeshName    String?  @db.VarChar(100)
  /// JSON TextureConfig
  textureConfig    Json?
  sortOrder        Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@map("product_print_areas")
}

model ProductModel {
  id            Int       @id @default(autoincrement())
  productId     Int       @unique
  modelUrl      String?   @db.VarChar(500)
  thumbnailUrl  String?   @db.VarChar(500)
  modelType     ModelType @default(PRIMITIVE)
  /// JSON ModelConfiguration (mesh bindings, primitive params, materials)
  configuration Json
  /// JSON ModelValidationReport from the asset ingestion pipeline
  validation    Json?
  /// 0-100 quality score from validation
  qualityScore  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_models")
}

model Design {
  id           Int      @id @default(autoincrement())
  userId       Int
  productId    Int
  variantId    Int?
  name         String   @db.VarChar(160)
  /// JSON DesignDocument
  designJson   Json
  previewImage String?  @db.VarChar(500)
  /// Public share link token; null = private
  shareToken   String?  @unique @db.VarChar(64)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  versions   DesignVersion[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([userId, updatedAt])
  @@index([productId])
  @@map("designs")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String?  @db.VarChar(60)
  /// Sanitized JSON details (never tokens/passwords/customer content)
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model DesignVersion {
  id           Int      @id @default(autoincrement())
  designId     Int
  version      Int
  designJson   Json
  previewImage String?  @db.VarChar(500)
  createdAt    DateTime @default(now())

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, version])
  @@map("design_versions")
}

model UploadedAsset {
  id        Int      @id @default(autoincrement())
  userId    Int
  fileName  String   @db.VarChar(255)
  fileUrl   String   @db.VarChar(500)
  fileType  String   @db.VarChar(100)
  fileSize  Int
  /// JSON: { width, height, format, hasAlpha }
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("uploaded_assets")
}

model DesignTemplate {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(160)
  category     String       @db.VarChar(80)
  /// JSON: { canvas: { width, height }, elements: DesignElement[] }
  templateJson Json
  previewImage String?      @db.VarChar(500)
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([category])
  @@map("product_templates")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         Int     @id @default(autoincrement())
  cartId     Int
  productId  Int
  variantId  Int?
  designId   Int?
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  design  Design?         @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int
  orderNumber     String        @unique @db.VarChar(40)
  status          OrderStatus   @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  shipping        Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(UNPAID)
  /// JSON shipping address snapshot
  shippingAddress Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int
  productId      Int
  variantId      Int?
  designId       Int?
  quantity       Int
  price          Decimal @db.Decimal(10, 2)
  /// Immutable snapshot of the design at purchase time (DesignDocument JSON)
  designSnapshot Json?
  /// Snapshot of product/variant names for display stability
  productName    String  @db.VarChar(160)
  variantName    String? @db.VarChar(160)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  design  Design?         @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Shopify app
// ---------------------------------------------------------------------------

enum ShopifyCustomizationStatus {
  DRAFT
  ORDERED
}

/// One installed Shopify store. The offline access token is encrypted at
/// rest (AES-256-GCM, see modules/shopify/shopify.crypto.ts).
model ShopifyShop {
  id            Int       @id @default(autoincrement())
  shopDomain    String    @unique @db.VarChar(255)
  accessToken   String?   @db.VarChar(1024)
  scope         String?   @db.VarChar(1000)
  name          String?   @db.VarChar(255)
  email         String?   @db.VarChar(255)
  currency      String?   @db.VarChar(10)
  primaryDomain String?   @db.VarChar(255)
  /// JSON ShopifySettings (button label, launch mode, …)
  settings      Json?
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  mappings       ShopifyProductMapping[]
  customizations ShopifyCustomization[]
  orders         ShopifyOrder[]

  @@map("shopify_shops")
}

/// Links a Shopify product to a customizer product (print areas, 3D model,
/// pricing rules). Optional per-variant map: Shopify variant id → customizer
/// variant id, auto-matched by colour/option name when the link is created.
model ShopifyProductMapping {
  id                  Int      @id @default(autoincrement())
  shopId              Int
  shopifyProductId    String   @db.VarChar(40)
  shopifyProductTitle String   @db.VarChar(255)
  shopifyHandle       String?  @db.VarChar(255)
  productId           Int
  /// JSON Record<shopifyVariantId, customizerVariantId>
  variantMap          Json?
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shop    ShopifyShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@unique([shopId, shopifyProductId])
  @@index([productId])
  @@map("shopify_product_mappings")
}

/// A storefront customer's design. Customers never sign in to the customizer:
/// the public token travels in the cart line-item properties and the edit key
/// (hashed) lets the same browser keep editing until it is ordered.
model ShopifyCustomization {
  id               Int                        @id @default(autoincrement())
  shopId           Int
  token            String                     @unique @db.VarChar(64)
  editKeyHash      String                     @db.VarChar(128)
  productId        Int
  variantId        Int?
  shopifyProductId String?                    @db.VarChar(40)
  shopifyVariantId String?                    @db.VarChar(40)
  /// JSON DesignDocument
  designJson       Json
  previewImage     String?                    @db.VarChar(500)
  status           ShopifyCustomizationStatus @default(DRAFT)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  shop       ShopifyShop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product    Product            @relation(fields: [productId], references: [id])
  orderItems ShopifyOrderItem[]

  @@index([shopId, status, updatedAt])
  @@map("shopify_customizations")
}

/// A Shopify order containing at least one customized line item, captured
/// from the orders/create webhook. Only what production needs is stored.
model ShopifyOrder {
  id                Int       @id @default(autoincrement())
  shopId            Int
  shopifyOrderId    String    @db.VarChar(40)
  orderName         String    @db.VarChar(40)
  financialStatus   String?   @db.VarChar(40)
  fulfillmentStatus String?   @db.VarChar(40)
  currency          String?   @db.VarChar(10)
  totalPrice        Decimal?  @db.Decimal(12, 2)
  customerEmail     String?   @db.VarChar(255)
  cancelledAt       DateTime?
  shopifyCreatedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop  ShopifyShop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items ShopifyOrderItem[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId, createdAt])
  @@map("shopify_orders")
}

model ShopifyOrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  lineItemId      String   @db.VarChar(40)
  customizationId Int?
  productId       Int?
  title           String   @db.VarChar(255)
  variantTitle    String?  @db.VarChar(255)
  sku             String?  @db.VarChar(120)
  quantity        Int
  price           Decimal? @db.Decimal(12, 2)
  /// Immutable DesignDocument snapshot taken when the order arrived
  designSnapshot  Json?
  previewImage    String?  @db.VarChar(500)

  order         ShopifyOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customization ShopifyCustomization? @relation(fields: [customizationId], references: [id], onDelete: SetNull)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("shopify_order_items")
}
